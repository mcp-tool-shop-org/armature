# Generated artifacts — the record is specs, reports, provenance JSON and sha256 manifests,
# never the binaries themselves.
outputs/
scratch/
*.mp4
*.mov
*.webm
*.glb
*.gltf
*.blend
*.blend1
*.exr
*.npy

# Renders and sheets live under outputs/; anything that escapes is still ignored by extension
# EXCEPT documentation figures, which are committed deliberately under docs/figures/.
!docs/figures/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build artifacts. The published package is built by CI from a tag, never from a local
# tree, so a wheel that rode a commit could only ever disagree with the one users get.
dist/
build/
npm/*.tgz

# Site (Astro/Starlight under site/). The lockfile IS committed — CI runs
# `npm ci`, so the build that runs there is the build verified on the rig.
site/node_modules/
site/dist/
site/.astro/

# Translation run cache (polyglot-mcp). The translated READMEs are committed; the
# segment cache is a local artifact and demonstrably serves stale chunks exactly
# when a number changes, so it never rides a commit.
.polyglot-cache.json

# Secrets — API keys for cloud generation never enter the repo
.env
*.key
credentials.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
